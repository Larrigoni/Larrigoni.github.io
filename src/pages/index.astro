---
/**
 * Home: pagina lunga ad ancore, 12 sezioni nell'ordine del brief §11.1. Tutti
 * i testi vengono da src/data/home.ts; i progetti dalla collection. Una
 * sezione che non ha dati non c'è (Print Lab), un blocco senza dati neppure
 * (i case, il visual dell'hero): mai segnaposto.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Compare from '../components/Compare.astro';
import ContactPanel from '../components/ContactPanel.astro';
import Giri from '../components/Giri.astro';
import Hero from '../components/Hero.astro';
import Manifesto from '../components/Manifesto.astro';
import Partenza from '../components/Partenza.astro';
import PrintLabBand from '../components/PrintLabBand.astro';
import Progetti from '../components/Progetti.astro';
import Ricevi from '../components/Ricevi.astro';
import Scraps from '../components/Scraps.astro';
import SectionHead from '../components/SectionHead.astro';
import Sheet from '../components/Sheet.astro';
import Timeline from '../components/Timeline.astro';
import { home } from '../data/home.ts';
import type { Section } from '../data/home.ts';
import { getPublishedProjects } from '../lib/content.ts';
import { homeCases, showsPrintLab } from '../lib/projects.ts';

const section = (id: Section['id']) => {
  const found = home.sections.find((s) => s.id === id);
  if (!found) throw new Error(`home.ts: manca la sezione «${id}».`);
  return found;
};

const projects = await getPublishedProjects();
const cases = homeCases(projects);

// Il visual dell'hero è la copertina del primo progetto in vetrina (brief §6.19, Appendice C.4).
const heroCase = cases[0];
const visual = heroCase?.data.cover ? { shot: heroCase.data.cover, project: heroCase.data.title } : undefined;

const metodo = section('metodo');
const prosegue = section('prosegue');
---

<BaseLayout>
  <Hero section={section('hero')} visual={visual} />
  <Ricevi section={section('ricevi')} />
  <Scraps section={section('problema')} />

  <Progetti section={section('progetti')} cases={cases} />

  <Partenza section={section('partenza')} />
  <Manifesto section={section('manifesto')} />

  <section class="section alt" id={metodo.id} aria-labelledby={`${metodo.id}-titolo`}>
    <div class="wrap">
      <SectionHead eyebrow={metodo.eyebrow} title={metodo.title} lead={metodo.lead} titleId={`${metodo.id}-titolo`} />
      <Giri items={metodo.items ?? []} closing={metodo.closing} />
    </div>
  </section>

  <section class="section" id={prosegue.id} aria-labelledby={`${prosegue.id}-titolo`}>
    <div class="wrap">
      <SectionHead eyebrow={prosegue.eyebrow} title={prosegue.title} lead={prosegue.lead} titleId={`${prosegue.id}-titolo`} />
      <Timeline items={prosegue.items ?? []} note={prosegue.note} cta={prosegue.cta?.ghost} />
    </div>
  </section>

  <Sheet section={section('perchi')} />
  <Compare section={section('domanda')} />
  {showsPrintLab(projects) && <PrintLabBand section={section('printlab')} />}
  <ContactPanel section={section('contatto')} />
</BaseLayout>
