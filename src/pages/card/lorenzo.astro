---
/**
 * /card/lorenzo (brief §6.19): la pagina che apre il tag NFC del biglietto.
 * Disegno «La frase» (Claude Design, 2026-10-16): in alto monogramma e
 * occhiello, al centro la frase su cosa faccio con «su misura» in rosso, sotto
 * la firma (nome, cellulare, email), in fondo le azioni sotto il pollice:
 * «Salva il contatto» piena (il .vcf), «Scrivimi» e «Il portfolio» ghost.
 * Niente pannello sospeso: la colonna occupa tutta l'altezza dello schermo.
 *
 * «Salva il contatto» esiste in due versioni e la pagina ne mostra una sola
 * (pages.css, senza JavaScript):
 * - il .vcf, su iPhone e sui computer. Senza `download`: su iPhone Safari
 *   l'attributo manda il file nei Download invece di aprire la scheda
 *   «Aggiungi contatto»;
 * - su Android, dove un .vcf si scarica sempre, il link «intent» che apre
 *   Contatti già compilato (src/lib/contact-intent.ts), con il .vcf come ripiego.
 */
import CardLayout from '../../layouts/CardLayout.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Logo from '../../components/Logo.astro';
import { pages } from '../../data/pages.ts';

const { meta, eyebrow, claim, name, phone, email, save, saveAndroid, write, portfolio } = pages.card;
const [before, after] = claim.text.split(claim.accent);
---

<CardLayout title={meta.title} description={meta.description}>
  <div class="vcard">
    <div class="vcard__top">
      <Logo size={64} decorative />
      <Eyebrow text={eyebrow} bare />
    </div>
    <div class="vcard__main">
      <p class="vcard__claim">{before}<span class="vcard__accent">{claim.accent}</span>{after}</p>
      <div class="vcard__sign">
        <h1 class="vcard__name">{name}</h1>
        <a class="vcard__tel" href={phone.href}>{phone.label}</a>
        <p class="vcard__mail">{email}</p>
      </div>
    </div>
    <div class="vcard__actions">
      <a class="btn primary vcard__save vcard__save--vcf" href={save.href}>{save.label}</a>
      <a class="btn primary vcard__save vcard__save--android" href={saveAndroid.href}>{saveAndroid.label}</a>
      <a class="btn" href={write.href}>{write.label}</a>
      <a class="btn" href={portfolio.href}>{portfolio.label}</a>
    </div>
  </div>
</CardLayout>
