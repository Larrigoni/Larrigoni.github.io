---
/**
 * /card/lorenzo (brief §6.19): la pagina che apre il tag NFC. Un pannello
 * solo: monogramma, nome, ruolo, «Salva il contatto» piena (il .vcf), poi
 * «Scrivimi» e «Guarda il portfolio» ghost, tutti a tutta larghezza.
 */
import CardLayout from '../../layouts/CardLayout.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Logo from '../../components/Logo.astro';
import { pages } from '../../data/pages.ts';

const { meta, name, role, save, write, portfolio } = pages.card;
---

<CardLayout title={meta.title} description={meta.description}>
  <div class="vcard">
    <Logo size={64} decorative />
    <h1 class="vcard__name">{name}</h1>
    <Eyebrow text={role} bare />
    <div class="vcard__actions">
      <a class="btn primary" href={save.href} download>{save.label}</a>
      <a class="btn" href={write.href}>{write.label}</a>
      <a class="btn" href={portfolio.href}>{portfolio.label}</a>
    </div>
  </div>
</CardLayout>
