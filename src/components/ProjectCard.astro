---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, status, category, summary, originalDesign, printer, software } = project.data;

const statusLabels: Record<string, string> = {
  concept: 'In coda',
  'in-sviluppo': 'In sviluppo',
  prototipo: 'In prova',
  completato: 'Validato',
};

const categoryLabels: Record<string, string> = {
  'smart-objects': 'Smart Objects',
  'custom-fit': 'Custom Fit',
  'process-tools': 'Process Tools',
  'print-lab': 'Print Lab',
};
---

<article class="pcard">
  <div class="shot">
    <div class="figure">
      <span class="big">Foto del pezzo — in arrivo</span>
      <span class="cap">Placeholder · 4:3 · fondo neutro</span>
    </div>
  </div>
  <div class="body">
    <div class="badges">
      <span class:list={['badge', { accent: originalDesign }]}>
        {originalDesign ? 'Originale' : 'Print Lab'}
      </span>
      <span class="badge cyan">{categoryLabels[category]}</span>
      <span class="badge">{statusLabels[status]}</span>
    </div>
    <h3>{title}</h3>
    <p class="summary">{summary}</p>
    <dl class="meta">
      <span class="pair"><dt>Stampante</dt><dd>{printer}</dd></span>
      <span class="pair"><dt>CAD</dt><dd>{software.join(', ')}</dd></span>
    </dl>
  </div>
</article>
