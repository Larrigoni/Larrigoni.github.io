---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, status, category, summary, originalDesign, printer, materials, pieces, image, imageAlt, hasPage, featured } =
  project.data;

const pageUrl = hasPage ? `/projects/${project.id}/` : undefined;

const statusLabels: Record<string, string> = {
  concept: 'In coda',
  'in-sviluppo': 'In sviluppo',
  prototipo: 'In prova',
  completato: 'Validato',
};

const categoryLabels: Record<string, string> = {
  'smart-objects': 'Smart Objects',
  'custom-fit': 'Su misura',
  'process-tools': 'Process Tools',
  'print-lab': 'Print Lab',
};
---

<article class="pcard">
  {
    image ? (
      pageUrl ? (
        <a class="shot" href={pageUrl}>
          <img src={image} alt={imageAlt ?? title} loading="lazy" />
        </a>
      ) : (
        <div class="shot">
          <img src={image} alt={imageAlt ?? title} loading="lazy" />
        </div>
      )
    ) : (
      <div class="shot">
        <div class="figure">
          <span class="big">Foto del pezzo — in arrivo</span>
          <span class="cap">Placeholder · 4:3 · fondo neutro</span>
        </div>
      </div>
    )
  }
  <div class="body">
    <div class="badges">
      <span class:list={['badge', originalDesign ? (featured ? 'accent' : 'cyan') : '']}>
        {originalDesign ? (featured ? 'Progetto originale' : 'Originale') : 'Print Lab'}
      </span>
      {materials.length === 0 && <span class="badge">{categoryLabels[category]}</span>}
      {status !== 'completato' && <span class="badge accent">{statusLabels[status]}</span>}
      {materials.length > 0 && <span class="badge eco">{materials[0]}</span>}
    </div>
    <h3>
      {pageUrl ? <a class="title-link" href={pageUrl}>{title}</a> : title}
    </h3>
    <p class="summary">{summary}</p>
    <dl class="meta">
      {pieces && <span class="pair"><dt>Pezzi</dt><dd>{pieces}</dd></span>}
      {materials.length > 0 && <span class="pair"><dt>Materiale</dt><dd>{materials.join(', ')}</dd></span>}
      {!pieces && materials.length === 0 && (
        <span class="pair"><dt>Stampante</dt><dd>{printer}</dd></span>
      )}
    </dl>
  </div>
</article>

<style>
  .title-link {
    color: inherit;
    text-decoration: none;
  }

  .title-link:hover {
    color: var(--red);
  }
</style>
