---
/**
 * Tavola 01 · Per chi è (brief §6.13): l'unico foglio a griglia del sito.
 *
 * Chip al posto dell'occhiello → titolo a una frase con il trattino cordolo →
 * lead; poi due colonne velate sul foglio («sì» con la spunta, «no» con il
 * meno) e la nota sulle categorie escluse. Nessuno stato: non è interattivo.
 * Tutti i testi arrivano da `home.ts`, sezione `perchi`; se un dato manca, il
 * blocco non c'è. Stili in `styles/components/argument.css`.
 */
import Eyebrow from './Eyebrow.astro';
import ItemText from './ItemText.astro';
import Rich from './Rich.astro';
import type { Section } from '../data/home.ts';

interface Props {
  /** La sezione `perchi` di home.ts: eyebrow (il chip), title, lead, headA + items, headB + itemsB, note. */
  section: Section;
  /** id della sezione, cioè l'ancora della nav (`#perchi`). Di norma è `section.id`. */
  id?: string;
}

const { section, id = section.id } = Astro.props;
const { eyebrow, title, lead, headA, items = [], headB, itemsB = [], note } = section;
const titleId = `${id}-titolo`;


const columns = [
  { key: 'si', head: headA, items: items },
  { key: 'no', head: headB, items: itemsB },
].filter((col) => col.head && col.items.length > 0);
---

<section class="section sheet" id={id} aria-labelledby={titleId}>
  <div class="wrap">
    <div class="section-head">
      <Eyebrow text={eyebrow} plain class="sheet__chip" />
      <h2 id={titleId}>
        {title.claim}
        {title.soft && <span class="t-soft">{title.soft}</span>}
      </h2>
      {lead && <p class="lead"><Rich text={lead} /></p>}
    </div>

    {
      columns.length > 0 && (
        <div class="sheet__cols">
          {columns.map((col) => (
            <div class:list={['sheet__col', `sheet__col--${col.key}`]}>
              <h3>{col.head}</h3>
              <ul class="sheet__list" role="list">
                {col.items.map((item) => (
                  <li>
                    {col.key === 'si' ? (
                      <svg class="sheet__icon" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                        <path d="M2.75 8.25 6.25 11.75 13.25 4.5" />
                      </svg>
                    ) : (
                      <svg class="sheet__icon" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false">
                        <path d="M3.25 8h9.5" />
                      </svg>
                    )}
                    <span>
                      <ItemText item={item} />
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )
    }

    {note && <p class="sheet__note"><Rich text={note} /></p>}
  </div>
</section>
