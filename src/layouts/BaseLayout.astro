---
import '@fontsource-variable/archivo';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Lorenzo Arrigoni — Progettazione 3D, prototipazione, soluzioni su misura',
  description = 'Progetto e realizzo oggetti che risolvono piccoli problemi reali: prototipi, accessori funzionali, ricambi non critici e oggetti intelligenti con NFC.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f6f3ec" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Lorenzo Arrigoni" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="it_IT" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <a class="skip-link" href="#contenuto">Salta al contenuto</a>
    <Header />
    <main id="contenuto">
      <slot />
    </main>
    <Footer />
  </body>
</html>
