---
import '../lib/fonts.ts';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Kerb from '../components/Kerb.astro';
import Nav from '../components/Nav.astro';
import { home } from '../data/home.ts';

interface Props {
  title?: string;
  description?: string;
  /** Immagine Open Graph con le sue misure; di default public/og.png (scripts/og). */
  image?: { src: string; width: number; height: number };
  /** La 404: niente canonical né og:url (non ha un indirizzo suo), e noindex. */
  notFound?: boolean;
}

const {
  title = home.meta.title,
  description = home.meta.description,
  image = { src: '/og.png', width: 1200, height: 630 },
  notFound = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image.src, Astro.site);
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {notFound ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0c0f17" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Lorenzo Arrigoni" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!notFound && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content="it_IT" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <a class="skip-link" href="#contenuto">Salta al contenuto</a>
    {/* Il cordolo sta prima della testata, non dentro: il contenimento di .site-header lo aggancerebbe a sé (chrome.css). */}
    <Kerb pos="top" />
    <Nav />
    <main id="contenuto">
      <slot />
    </main>
    <Footer />
  </body>
</html>
