---
/**
 * Kit: La domanda giusta (brief §6.14), resa con i testi veri di home.ts.
 * La resa a 375px (colonne impilate, divisore orizzontale) scatta con la
 * viewport: si vede restringendo la finestra o nella card home-mobile.
 */
import KitLayout from './KitLayout.astro';
import Specimen from './Specimen.astro';
import Compare from '../components/Compare.astro';
import { home } from '../data/home.ts';

const domanda = home.sections.find((s) => s.id === 'domanda');
if (!domanda) throw new Error('home.ts: manca la sezione «domanda»');
---

<KitLayout
  title="La domanda giusta"
  note="Un solo contenitore, due colonne divise da un filo da 1px. La colonna evidenziata è una: il pezzo su misura, con il tag tinto e i « + » in rosso testo. Sotto, il verdetto. Nessuno stato."
>
  <Specimen label="sezione intera · testi di home.ts (domanda) · rosso pieno: nessuno · tocchi rossi: tag FUNZIONA, gruppo dei « + »">
    <Compare section={domanda} />
  </Specimen>

  <Specimen label="sotto 760px · colonne impilate, padding 24, filo orizzontale fra le due">
    <p class="muted">La variante scatta sulla larghezza della finestra, non del campione: si vede nella card home-mobile, o restringendo questa pagina sotto 760px.</p>
  </Specimen>
</KitLayout>
